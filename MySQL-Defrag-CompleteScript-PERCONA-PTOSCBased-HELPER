nohup /defrag/tools/ptosc_restartable_defrag_PREPROD_FINAL.sh \
<SCHEMA> <TABLE> \
> /defrag/tools/<SCHEMA>.<TABLE>.restartable.nohup.out 2>&1 &
"""

